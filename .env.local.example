# Supabase — create a project at https://supabase.com/dashboard, then Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string — used to derive the daily-rotating anonymous visitor id.
# Generate one with: openssl rand -hex 32
VISITOR_ID_SALT=

# Stripe — https://dashboard.stripe.com/apikeys and https://dashboard.stripe.com/webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — enables rate limiting on the ingestion endpoint. Leave blank to skip it.
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The deployed URL of this app (used for the embed-snippet generator and Stripe redirect URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
